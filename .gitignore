# ─────────────────────────────────────────────────────────────────────────────
# ARTHA — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (CRITICAL — never commit) ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Testing ───────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
*.cover
.hypothesis/

# ── Data cache (large files, regenerated on demand) ───────────────────────
data_cache/
*.parquet

# ── Database files (local dev only — production uses Supabase Postgres) ──
*.db
*.sqlite
*.sqlite3

# ── Output data (generated by the system) ─────────────────────────────────
data/Outputs/*.json
data/Reports/simulation_*.json

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Node/Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/

# ── Docker ────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
