# ─────────────────────────────────────────────────────────────────────────────
# ARTHA — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers ─────────────────────────────────────────────────────────
# Google AI Studio (Gemini) — RECOMMENDED primary provider
# Free tier: 1500 RPD on Flash, 50 RPD on Pro
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — secondary / fallback provider
# Free tier: 14,400 req/day on llama-3.1-8b-instant
# Get your key: https://console.groq.com/keys
# NOTE: Use ONE key only. Multiple keys from the same org share one rate-limit bucket.
GROQ_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────
# Supabase Postgres — production database
# Get yours free: https://supabase.com/dashboard
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Fallback: SQLite (local dev only, no setup needed)
# If DATABASE_URL is empty, the system uses SQLite at data_cache/factstore.db
# DATABASE_URL=sqlite:///data_cache/factstore.db

# ── Supabase Auth (optional, for login management) ───────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# Secret key for JWT token signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
