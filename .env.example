# ─────────────────────────────────────────────────────────────────────────────
# ARTHA — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers ─────────────────────────────────────────────────────────
# Google AI Studio (Gemini) — RECOMMENDED primary provider
# Free tier: 1500 RPD on Flash, 50 RPD on Pro
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — secondary / fallback provider (check current quotas in the Groq console)
# Get your key: https://console.groq.com/keys
# NOTE: Use ONE key only. Multiple keys from the same org share one rate-limit bucket.
GROQ_API_KEY=

# Optional model overrides (hosted catalogues change; see
# https://console.groq.com/docs/deprecations). Defaults shown.
# ARTHA_GEMINI_MODEL=gemini/gemini-3.6-flash
# ARTHA_GROQ_SMALL_MODEL=groq/openai/gpt-oss-20b
# ARTHA_GROQ_LARGE_MODEL=groq/openai/gpt-oss-120b

# Optional local fallback — only used if the server actually responds.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=ollama/llama3.1:8b
# ARTHA_DISABLE_OLLAMA=false

# Max seconds a call waits for a rate-limited provider to cool down
# before giving up and letting the caller use its deterministic fallback.
# LLM_MAX_WAIT_SECONDS=70

# ── Database ──────────────────────────────────────────────────────────────
# Supabase Postgres — production database
# Get yours free: https://supabase.com/dashboard
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Fallback: SQLite (local dev only, no setup needed)
# If DATABASE_URL is empty, the system uses SQLite at data_cache/factstore.db
# DATABASE_URL=sqlite:///data_cache/factstore.db

# ── Supabase Auth (optional, for login management) ───────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# Secret key for JWT token signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Zerodha Kite Connect (read-only market data) ────────────────────────────
# From https://developers.kite.trade/apps — never commit real values.
# Redirect URL registered on the Kite app must match KITE_REDIRECT_URL exactly.
# The access token is generated daily via the login flow; leave it empty.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/kite/callback
KITE_ACCESS_TOKEN=

# ── Paper trading (simulated orders only; no broker order API is ever called) ──
# Runs the quant engine on a schedule: every 5 min during NSE hours, marks only otherwise.
PAPER_TRADING_ENABLED=true

# ── Deployment security (see docs/DEPLOYMENT.md) ───────────────────────────────
# Production refuses to start unless AUTH_REQUIRED=true and SUPABASE_JWT_SECRET is set.
AUTH_REQUIRED=false
SUPABASE_JWT_SECRET=
# The operator: only these accounts may connect/disconnect Kite, run the paper
# engine, or rebuild caches. Comma-separated.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Number of reverse proxies in front of the app (Render/HF Spaces/Railway: 1;
# Cloudflare in front of one of those: 2). 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# ── Who pays for AI reports (app/llm/keys.py) ──────────────────────────────────
# unlimited = your keys for everyone (dev default) · demo = your keys, capped
# (production default) · off = visitors must bring their own Groq/Gemini key.
LLM_OWNER_KEYS=unlimited
DEMO_JOBS_PER_VISITOR=3
DEMO_JOBS_PER_DAY=25
